# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# 배포 플랫폼(Vercel·Cloudflare)에도 같은 값을 환경변수로 넣어야 합니다.
# 특히 NEXT_PUBLIC_SITE_URL 이 없으면 canonical·sitemap 이 localhost 로 나가 색인이 망가집니다.

# ── 사이트 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=미용입시학원 학원비 비교
NEXT_PUBLIC_SITE_SHORT=미용입시 학원비 비교

# ── DB 수집 ────────────────────────────────────────────
NEXT_PUBLIC_DB_SUBMIT_URL=https://project-db-bd.vercel.app/api/submit
# 이 사이트 전용 API 키 (없으면 폼 전송이 실패합니다)
NEXT_PUBLIC_DB_API_KEY=

# ── 운영 주체 (개인정보처리방침·약관·푸터에 표시) ──────
# 비워두면 화면에 자리표시자가 노출되므로 배포 전 반드시 채우세요.
NEXT_PUBLIC_COMPANY=
NEXT_PUBLIC_PARTNER=
NEXT_PUBLIC_PARTNER_DESC=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_HOURS=월~토 10:00 ~ 19:00 (일요일·공휴일 휴무)
NEXT_PUBLIC_PRIVACY_OFFICER=
NEXT_PUBLIC_POLICY_DATE=2026년 9월 5일
NEXT_PUBLIC_BIZ_NUMBER=

# ── 광고·분석 (비어 있으면 해당 스크립트를 넣지 않음) ──
NEXT_PUBLIC_ADSENSE_PUB=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_NAVER_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── 구조화 데이터 sameAs (콤마 구분, 운영 주체 공식 채널만) ──
NEXT_PUBLIC_PROFILES=
